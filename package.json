{
  "name": "yang-browser-engine",
  "version": "0.1.0",
  "description": "Browser-first TypeScript foundation for YANG 1.1 schema compilation and UI introspection.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "ARCHITECTURE.md",
    "ROADMAP.md",
    "TESTING.md",
    "XPATH_SPIKE.md",
    "CONFORMANCE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-example.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "pretest": "npm run build",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@xmldom/xmldom": "^0.9.12",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "xpath": "^0.0.36"
  }
}
