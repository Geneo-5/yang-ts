{
  "name": "yang-browser-engine",
  "version": "0.1.0",
  "description": "Browser-first TypeScript foundation for YANG 1.1 schema compilation and UI introspection.",
  "type": "module",
  "bin": {
    "yang-browser-engine": "./dist/bin/cli.js"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "ARCHITECTURE.md",
    "CONFORMANCE.md",
    "GUIDE.md",
    "NEXTJS.md",
    "ROADMAP.md",
    "TESTING.md",
    "XPATH_SPIKE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-example.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "next-static:build": "npm run build && next build examples/next-static",
    "next-static:serve": "node examples/next-static/mock-restconf.mjs",
    "next-static:check": "node scripts/check-next-static.mjs",
    "next-static:e2e": "npm run next-static:build && npm run next-static:check && node scripts/next-static-e2e.mjs",
    "next-static:e2e:basepath": "NEXT_PUBLIC_BASE_PATH=/yang-console npm run next-static:build && NEXT_PUBLIC_BASE_PATH=/yang-console npm run next-static:check && NEXT_PUBLIC_BASE_PATH=/yang-console node scripts/next-static-e2e.mjs",
    "pretest": "npm run build",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "dev": "node scripts/dev-server.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@xmldom/xmldom": "^0.9.12",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "next": "^16.4.6",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "xpath": "^0.0.36"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
